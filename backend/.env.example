# 应用
APP_NAME=DataMind
ENVIRONMENT=dev
DEBUG=true

# 基础设施
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=kb
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql+asyncpg://datamind:datamind@127.0.0.1:5432/datamind
# 留空则使用本地开发默认密钥；生产环境务必设置为 32 字节 urlsafe base64 密钥
FERNET_KEY=

# 模型（OpenAI 兼容协议示例，后续由模型网关接入更多厂商）
MODEL_DEFAULT=openai/gpt-4o-mini
EMBEDDING_DEFAULT=openai/text-embedding-3-small
# 备用模型链，逗号分隔；主模型失败时按顺序降级
MODEL_FALLBACKS=

# 各厂商 API Key 按 LiteLLM 约定注入，例如：
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

